{
	"name": "link-dictate-co",
	"version": "0.1.1",
	"description": "Click vault links to insert them into Handy voice dictation.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"test": "bun test",
		"typecheck": "tsc -noEmit -skipLibCheck"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"voice",
		"dictation"
	],
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^22.15.17",
		"builtin-modules": "3.3.0",
		"bun-types": "1.4.3",
		"esbuild": "0.23.0",
		"obsidian": "latest",
		"typescript": "^5.8.3"
	}
}
